APP_NAME="Bali Santih"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://balisantih.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.balisantih.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@balisantih.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Pesanan layanan (balisantih.com/pesan)
ORDER_ADMIN_EMAIL=admin.balisantih@gmail.com
# Nomor WhatsApp admin format 628xxx, kosongkan untuk menyembunyikan tombol WhatsApp
ORDER_WHATSAPP_NUMBER=

# iPaymu payment gateway (kredensial produksi dari my.ipaymu.com)
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_SANDBOX=false
